# Auth service the /auth interface talks to. Defaults to the production issuer when unset.
VITE_AUTH_BASE_URL=https://api.franciscosolis.cl/auth

# Client ID this site is registered under. The application must exist on the auth service with
# <origin>/auth/callback among its redirect URIs — for local work that is
# http://localhost:5173/auth/callback.
VITE_AUTH_CLIENT_ID=franciscosolis-web

# Redirect URI path the site asks the auth service to return the browser to. Only set this when the
# application is registered under a path other than the callback route itself; the landing is
# forwarded to /auth/callback either way.
# VITE_AUTH_REDIRECT_PATH=/auth/callback

# CMS service the /cms interface reads from. Defaults to the production one when unset.
VITE_CMS_BASE_URL=https://api.franciscosolis.cl/cms

# Client ID the CMS is registered under. It is a separate application with its own entry on the
# auth service.
VITE_CMS_CLIENT_ID=franciscosolis-cms

# Redirect URI path the CMS asks for. It defaults to the pre-move /apps/cms/callback, because that
# is what the application is still registered under — <origin>/cms/callback is refused with
# "redirect_uri is not registered for this client". The landing is forwarded to /cms/callback with
# the code and state intact. Once <origin>/cms/callback is registered under Admin → Applications,
# set this to /cms/callback and the extra hop disappears.
# VITE_CMS_REDIRECT_PATH=/cms/callback

# Marketplace service, read by /product/* and edited from the console at /marketplace. Defaults to
# the production one when unset.
VITE_MARKETPLACE_BASE_URL=https://api.franciscosolis.cl/marketplace

# Client ID the marketplace console is registered under. Unlike the standalone app pages it replaced
# — whose editor lived inside the CMS because that service took the CMS's audience — apps/marketplace
# accepts only its own. A console signing in under franciscosolis-cms is refused with a 401 before
# the permission is ever read, which reads on this side as an expired session and loops.
#
# The buying and reviewing half needs nothing here: it is called with the *site's* own session
# (franciscosolis-web), which the service accepts on a second audience list with no domain gate.
VITE_MARKETPLACE_CLIENT_ID=franciscosolis-marketplace

# Redirect URI the console asks for. It matches the route this site serves, which is the whole point:
# redirect URIs are compared byte for byte.
# VITE_MARKETPLACE_REDIRECT_PATH=/marketplace/callback

# Support service the /help centre, the ticket views and the /support console read from. Defaults to
# the production one when unset.
VITE_SUPPORT_BASE_URL=https://api.franciscosolis.cl/support

# Client ID the support console is registered under. Unlike the standalone app pages, support is its
# own application: tickets are assignable to people, and the auth service resolves roles per
# application — so a client id of its own is what produces a set of people to assign them to.
VITE_SUPPORT_CLIENT_ID=franciscosolis-support

# Redirect URI the console asks for. It matches the route this site serves, which is the whole point:
# redirect URIs are compared byte for byte. Registered by apps/auth/migrations/0010_support_application.sql.
# VITE_SUPPORT_REDIRECT_PATH=/support/callback
