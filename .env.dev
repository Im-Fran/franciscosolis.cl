# The development build: what `pnpm run build:dev` bakes into the bundle that becomes
# dev.franciscosolis.cl.
#
# Every base URL here names the `-dev` half of the API. That is the whole environment in one file:
# the development site and the production site are the same code, and the only thing that decides
# which data a visitor sees is which API the bundle was built against.
#
# Nothing secret belongs here. These values are compiled into JavaScript that anybody can read, and
# they are committed for exactly that reason — the build has to be reproducible from the repository.
#
# The client ids are unchanged on purpose: an application is registered per auth database, and the
# development stack has its own. So `franciscosolis-web` on api-dev is a different application with
# its own secret and its own redirect URIs, registered with
# `pnpm run applications -- create franciscosolis-web --dev --remote` in the API repository.

VITE_AUTH_BASE_URL=https://api-dev.franciscosolis.cl/auth
VITE_AUTH_CLIENT_ID=franciscosolis-web

VITE_CMS_BASE_URL=https://api-dev.franciscosolis.cl/cms
VITE_CMS_CLIENT_ID=franciscosolis-cms

# Set here and not in production because the development applications are registered from scratch:
# production still carries the pre-move /apps/cms/callback and the extra hop it costs. Register
# https://dev.franciscosolis.cl/cms/callback on the dev auth database and the hop never exists here.
VITE_CMS_REDIRECT_PATH=/cms/callback

VITE_PAGES_BASE_URL=https://api-dev.franciscosolis.cl/pages

VITE_SUPPORT_BASE_URL=https://api-dev.franciscosolis.cl/support
VITE_SUPPORT_CLIENT_ID=franciscosolis-support
